# Source data and experiment outputs stay local.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/manifests/*
!data/manifests/.gitkeep
artifacts/*
!artifacts/.gitkeep
*.sqlite
*.sqlite3
*.sqlite3-*
*.db
*.db-*
